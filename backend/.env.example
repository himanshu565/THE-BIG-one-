# Application Environment
APP_ENV=development

# Database Configuration
# Option A (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/vectorly
#
# Option B (Zero-config local SQLite):
DATABASE_URL=sqlite:///./vectorly.db

# Redis (optional for future caching/queues)
REDIS_URL=redis://localhost:6379/0

# LLM Synthesis Provider
# Supported providers: mock, openai, gemini, ollama
LLM_PROVIDER=mock
LLM_MODEL=local-development

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Google Gemini Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama Local LLM Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# JWT Authentication
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

