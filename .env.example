# Application Environment
APP_ENV=development

# Database Configuration
# Option A (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/vectorly
#
# Option B (Zero-config local SQLite):
DATABASE_URL=sqlite:///./vectorly.db

# Redis (optional for future caching/queues)
REDIS_URL=redis://localhost:6379/0

# LLM Synthesis Provider
LLM_PROVIDER=mock
LLM_MODEL=local-development

